@model HieuLongPortfolio.Models.ResumeData

@{
    ViewData["Title"] = "Resume";
}

<section class="resume-page">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="resume-header">

        <h1>
            RESUME
        </h1>

        <div class="resume-actions">

            <a asp-controller="Resume"
               asp-action="Pdf"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary">

                View PDF

            </a>


            <a asp-controller="Resume"
               asp-action="Pdf"
               asp-route-download="true"
               class="btn btn-secondary">

                Download PDF

            </a>

        </div>

    </div>


    <!-- =========================================
         SUMMARY
    ========================================== -->

    <section class="resume-section-block">

        <h2 class="section-title">
            Professional Summary
        </h2>

        <div class="resume-summary">

            <p>
                @Model.ProfessionalSummary
            </p>

        </div>

    </section>


    <!-- =========================================
         EDUCATION
    ========================================== -->

    <section class="resume-section-block">

        <h2 class="section-title">
            Education
        </h2>

        <div class="resume-entry">

            <div class="resume-date">
                @Model.Education.Date
            </div>


            <div class="resume-entry-content">

                <h3>
                    @Model.Education.Program
                </h3>

                <p class="resume-company">
                    @Model.Education.School
                </p>

                <p class="resume-location">
                    @Model.Education.Location
                </p>

            </div>

        </div>

    </section>


    <!-- =========================================
         EXPERIENCE
    ========================================== -->

    <section class="resume-section-block">

        <h2 class="section-title">
            Experience
        </h2>


        @foreach (var experience in Model.Experiences)
        {
            <div class="resume-entry">

                <div class="resume-date">
                    @experience.Date
                </div>


                <div class="resume-entry-content">

                    <h3>
                        @experience.Title
                    </h3>

                    <p class="resume-company">
                        @experience.Company
                    </p>


                    @if (!string.IsNullOrWhiteSpace(
                        experience.Location))
                    {
                        <p class="resume-location">
                            @experience.Location
                        </p>
                    }


                    @if (experience.Bullets.Any())
                    {
                        <ul>

                            @foreach (var bullet
                                in experience.Bullets)
                            {
                                <li>
                                    @bullet
                                </li>
                            }

                        </ul>
                    }

                </div>

            </div>
        }

    </section>


    <!-- =========================================
         TECHNICAL PROJECTS
    ========================================== -->

    <section class="resume-section-block">

        <h2 class="section-title">
            Technical Projects
        </h2>


        @foreach (var project in Model.Projects)
        {
            <div class="resume-project">

                <h3>
                    @project.Title
                </h3>


                <p class="resume-project-tech">
                    @project.Technologies
                </p>


                @if (project.Bullets.Any())
                {
                    <ul>

                        @foreach (var bullet
                            in project.Bullets)
                        {
                            <li>
                                @bullet
                            </li>
                        }

                    </ul>
                }

            </div>
        }

    </section>


    <!-- =========================================
         SKILLS
    ========================================== -->

    <section class="resume-section-block">

        <h2 class="section-title">
            Technical Skills
        </h2>


        <div class="resume-skills-grid">

            <div class="resume-skill-group">

                <h3>
                    PC Hardware & Support
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.PcHardwareSupport)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>


            <div class="resume-skill-group">

                <h3>
                    Languages
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.Languages)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>


            <div class="resume-skill-group">

                <h3>
                    Frameworks & Technologies
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.FrameworksTechnologies)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>


            <div class="resume-skill-group">

                <h3>
                    Databases
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.Databases)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>


            <div class="resume-skill-group">

                <h3>
                    Cloud & Deployment
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.CloudDeployment)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>


            <div class="resume-skill-group">

                <h3>
                    Embedded & Real-Time
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.EmbeddedRealTime)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>


            <div class="resume-skill-group resume-skill-group-wide">

                <h3>
                    Tools
                </h3>

                <div class="skill-tags">

                    @foreach (var skill
                        in Model.Skills.Tools)
                    {
                        <span>@skill</span>
                    }

                </div>

            </div>

        </div>

    </section>

</section>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard">

    <div class="admin-heading">

        <div>

            <p>
                ADMIN
            </p>

            <h1>
                Dashboard
            </h1>

        </div>


        <div class="admin-heading-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">

                View Portfolio

            </a>


            <form asp-controller="Admin"
                  asp-action="Logout"
                  method="post"
                  class="admin-logout-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary">

                    Logout

                </button>

            </form>

        </div>

    </div>


    <div class="dashboard-stats">

        <div class="stat-card">

            <p>
                Projects
            </p>

            <h2>
                @ViewBag.ProjectCount
            </h2>

        </div>


        <div class="stat-card">

            <p>
                Resume
            </p>

            <h2>
                PDF
            </h2>

        </div>


        <div class="stat-card">

            <p>
                Portfolio
            </p>

            <h2>
                Live
            </h2>

        </div>

    </div>


    <div class="admin-options">

        <div class="admin-card">

            <h2>
                Projects
            </h2>

            <p>
                Add, edit or remove portfolio projects.
            </p>

            <a asp-controller="Admin"
               asp-action="ManageProjects"
               class="btn btn-primary">

                Manage Projects

            </a>

        </div>


        <div class="admin-card">

            <h2>
                Resume
            </h2>

            <p>
                Upload and replace your current PDF resume.
            </p>

            <a asp-controller="Admin"
               asp-action="ManageResume"
               class="btn btn-primary">

                Manage Resume

            </a>

        </div>


        <div class="admin-card">

            <h2>
                Profile
            </h2>

            <p>
                Profile editing will be added later.
            </p>

            <button type="button"
                    class="btn btn-secondary"
                    disabled>

                Coming Soon

            </button>

        </div>


        <div class="admin-card">

            <h2>
                Skills
            </h2>

            <p>
                Skill management will be added later.
            </p>

            <button type="button"
                    class="btn btn-secondary"
                    disabled>

                Coming Soon

            </button>

        </div>


        <div class="admin-card">

            <h2>
                Messages
            </h2>

            <p>
                No contact form is connected yet.
            </p>

            <button type="button"
                    class="btn btn-secondary"
                    disabled>

                Coming Soon

            </button>

        </div>


        <div class="admin-card">

            <h2>
                Analytics
            </h2>

            <p>
                Analytics can later connect to LinkClicks.
            </p>

            <button type="button"
                    class="btn btn-secondary"
                    disabled>

                Coming Soon

            </button>

        </div>

    </div>

</section>
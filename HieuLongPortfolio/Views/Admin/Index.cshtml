@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="admin-heading">

        <div>

            <p>
                ADMIN
            </p>

            <h1>
                Dashboard
            </h1>

        </div>


        <div class="admin-heading-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">

                View Portfolio

            </a>


            <form asp-controller="Admin"
                  asp-action="Logout"
                  method="post"
                  class="admin-logout-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary">

                    Logout

                </button>

            </form>

        </div>

    </div>


    <!-- =========================================
         STATS
    ========================================== -->

    <div class="dashboard-stats">

        <div class="stat-card">

            <p>
                Projects
            </p>

            <h2>
                4
            </h2>

        </div>


        <div class="stat-card">

            <p>
                Messages
            </p>

            <h2>
                0
            </h2>

        </div>


        <div class="stat-card">

            <p>
                Portfolio Views
            </p>

            <h2>
                -
            </h2>

        </div>

    </div>


    <!-- =========================================
         ADMIN OPTIONS
    ========================================== -->

    <div class="admin-options">


        <!-- PROJECTS -->

        <div class="admin-card">

            <h2>
                Projects
            </h2>

            <p>
                Add, edit or remove portfolio projects.
            </p>

            <button type="button"
                    class="btn btn-primary">

                Manage Projects

            </button>

        </div>


        <!-- RESUME -->

        <div class="admin-card">

            <h2>
                Resume
            </h2>

            <p>
                Upload and manage your current resume.
            </p>

            <button type="button"
                    class="btn btn-primary">

                Manage Resume

            </button>

        </div>


        <!-- PROFILE -->

        <div class="admin-card">

            <h2>
                Profile
            </h2>

            <p>
                Update your profile information.
            </p>

            <button type="button"
                    class="btn btn-primary">

                Edit Profile

            </button>

        </div>


        <!-- SKILLS -->

        <div class="admin-card">

            <h2>
                Skills
            </h2>

            <p>
                Manage technologies and technical skills.
            </p>

            <button type="button"
                    class="btn btn-primary">

                Manage Skills

            </button>

        </div>


        <!-- MESSAGES -->

        <div class="admin-card">

            <h2>
                Messages
            </h2>

            <p>
                Read messages submitted through your portfolio.
            </p>

            <button type="button"
                    class="btn btn-primary">

                View Messages

            </button>

        </div>


        <!-- ANALYTICS -->

        <div class="admin-card">

            <h2>
                Analytics
            </h2>

            <p>
                View portfolio traffic and project statistics.
            </p>

            <button type="button"
                    class="btn btn-primary">

                View Analytics

            </button>

        </div>

    </div>

</section>
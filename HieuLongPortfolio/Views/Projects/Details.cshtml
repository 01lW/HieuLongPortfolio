@model Project

@{
    ViewData["Title"] = Model.Title;
}

<section class="project-details">

    <a asp-controller="Projects"
       asp-action="Index"
       class="back-link">

        ← Back to Projects

    </a>


    <div class="project-detail-header">

        <h1>
            @Model.Title
        </h1>

        <p class="project-detail-description">
            @Model.ShortDescription
        </p>

    </div>


    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="project-detail-image">

            <img src="@Model.ImageUrl"
                 alt="@Model.Title" />

        </div>
    }


    <section class="project-overview">

        <div class="project-overview-main">

            <h2>
                Overview
            </h2>

            <p>
                @Model.Description
            </p>

        </div>


        <div class="project-meta-card">

            @if (!string.IsNullOrEmpty(Model.ProjectType))
            {
                <div class="project-meta-item">

                    <span>
                        Project Type
                    </span>

                    <strong>
                        @Model.ProjectType
                    </strong>

                </div>
            }


            @if (!string.IsNullOrEmpty(Model.Team))
            {
                <div class="project-meta-item">

                    <span>
                        Team
                    </span>

                    <strong>
                        @Model.Team
                    </strong>

                </div>
            }


            @if (!string.IsNullOrEmpty(Model.Role))
            {
                <div class="project-meta-item">

                    <span>
                        My Role
                    </span>

                    <strong>
                        @Model.Role
                    </strong>

                </div>
            }


            @if (!string.IsNullOrEmpty(Model.Technologies))
            {
                <div class="project-meta-item">

                    <span>
                        Technologies
                    </span>

                    <strong>
                        @Model.Technologies
                    </strong>

                </div>
            }


            @if (!string.IsNullOrEmpty(Model.Hardware))
            {
                <div class="project-meta-item">

                    <span>
                        Hardware
                    </span>

                    <strong>
                        @Model.Hardware
                    </strong>

                </div>
            }

        </div>

    </section>


    @if (!string.IsNullOrEmpty(Model.MyContribution))
    {
        <section class="project-section">

            <h2 class="section-title">
                My Contribution
            </h2>

            <div class="project-text-box">

                <p>
                    @Model.MyContribution
                </p>

            </div>

        </section>
    }


    @if (Model.GalleryImages.Count > 0)
    {
        <section class="project-section">

            <h2 class="section-title">
                Interface Preview
            </h2>

            <p class="project-section-description">
                Screens and interface examples from @Model.Title.
            </p>


            <div class="project-gallery">

                @foreach (var image in Model.GalleryImages)
                {
                    <img src="@image"
                         alt="@Model.Title interface"
                         class="project-gallery-image" />
                }

            </div>

        </section>
    }


    @if (Model.Features.Count > 0)
    {
        <section class="project-section">

            <h2 class="section-title">
                Key Features
            </h2>


            <div class="feature-grid">

                @foreach (var feature in Model.Features)
                {
                    <div class="feature-card">

                        <span class="feature-icon">
                            ✓
                        </span>

                        <p>
                            @feature
                        </p>

                    </div>
                }

            </div>

        </section>
    }


    @if (!string.IsNullOrEmpty(Model.SystemArchitecture))
    {
        <section class="project-section">

            <h2 class="section-title">
                System Architecture
            </h2>

            <div class="project-text-box">

                <p>
                    @Model.SystemArchitecture
                </p>

            </div>

        </section>
    }


    @if (Model.Testing.Count > 0 ||
         Model.Challenges.Count > 0)
    {
        <section class="project-section">

            <div class="project-two-column">

                @if (Model.Testing.Count > 0)
                {
                    <div class="project-list-box">

                        <h2>
                            Testing
                        </h2>

                        <p class="project-list-description">
                            Testing performed during the development of @Model.Title.
                        </p>

                        <ul>

                            @foreach (var test in Model.Testing)
                            {
                                <li>
                                    @test
                                </li>
                            }

                        </ul>

                    </div>
                }


                @if (Model.Challenges.Count > 0)
                {
                    <div class="project-list-box">

                        <h2>
                            Challenges
                        </h2>

                        <p class="project-list-description">
                            Some of the main technical challenges encountered during development.
                        </p>

                        <ul>

                            @foreach (var challenge in Model.Challenges)
                            {
                                <li>
                                    @challenge
                                </li>
                            }

                        </ul>

                    </div>
                }

            </div>

        </section>
    }


    @if (!string.IsNullOrEmpty(Model.GitHubUrl) ||
         !string.IsNullOrEmpty(Model.DemoUrl))
    {
        <section class="project-actions">

            @if (!string.IsNullOrEmpty(Model.GitHubUrl))
            {
                <a href="@Model.GitHubUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-primary">

                    View GitHub ↗

                </a>
            }


            @if (!string.IsNullOrEmpty(Model.DemoUrl))
            {
                <a href="@Model.DemoUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-secondary">

                    Live Demo ↗

                </a>
            }

        </section>
    }

</section>
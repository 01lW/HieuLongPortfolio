@{
    ViewData["Title"] = "Custom PC Builds";
}

<section class="pc-builds-page">

    <a asp-controller="Projects"
       asp-action="Index"
       class="back-link">
        ← Back to Projects
    </a>


    <div class="pc-builds-header">

        <h1>
            PC BUILDS
        </h1>

    </div>


    <!-- =========================================
         OVERVIEW
    ========================================== -->

    <section class="pc-build-overview">

        <div class="pc-build-overview-content">

            <h2 class="section-title">
                Overview
            </h2>

            <p>
                I independently build custom gaming PCs with a focus on
                component compatibility, clean assembly, system stability,
                performance and presentation.
            </p>

            <p>
                My work includes hardware installation, BIOS configuration,
                Windows and driver setup, benchmarking, thermal testing,
                troubleshooting and customer support.
            </p>

        </div>


        <div class="pc-build-meta">

            <div class="project-meta-item">

                <span>
                    Role
                </span>

                <strong>
                    PC Builder & Technician
                </strong>

            </div>


            <div class="project-meta-item">

                <span>
                    Type
                </span>

                <strong>
                    Independent Technical Work
                </strong>

            </div>


            <div class="project-meta-item">

                <span>
                    Focus
                </span>

                <strong>
                    Gaming PCs & Hardware Support
                </strong>

            </div>


            <div class="project-meta-item">

                <span>
                    Skills
                </span>

                <strong>
                    Assembly, Diagnostics, BIOS, Windows,
                    Benchmarking & Customer Support
                </strong>

            </div>

        </div>

    </section>


    <!-- =========================================
         SELECTED BUILDS
    ========================================== -->

    <section class="pc-build-section">

        <h2 class="section-title">
            Selected Builds
        </h2>


        <div class="pc-build-list">


            <!-- =========================================
                 BUILD 1
                 7800X3D + RX 6800 XT
            ========================================== -->

            <article class="pc-build-card">

                <div class="pc-build-media">

                    <video controls
                           preload="metadata"
                           playsinline>

                        <source src="/videos/pc/7800x3d-rx6800xt.mp4"
                                type="video/mp4" />

                        Your browser does not support video playback.

                    </video>

                </div>


                <div class="pc-build-info">

                    <p class="pc-build-label">
                        HIGH PERFORMANCE GAMING BUILD
                    </p>

                    <h2>
                        Ryzen 7 7800X3D + RX 6800 XT
                    </h2>

                    <p>
                        A high-performance gaming system built on the AM5
                        platform, assembled and configured with an emphasis
                        on performance, cooling and presentation.
                    </p>


                    <div class="pc-spec-grid">

                        <div>

                            <span>
                                CPU
                            </span>

                            <strong>
                                Ryzen 7 7800X3D
                            </strong>

                        </div>


                        <div>

                            <span>
                                GPU
                            </span>


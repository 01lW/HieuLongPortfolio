<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Hieu Long Nguyen
    </title>

    <script type="importmap"></script>

    <script>
            (function () {
                const savedTheme =
                    localStorage.getItem("portfolio-theme");

                if (savedTheme) {
                    document.documentElement.setAttribute(
                        "data-theme",
                        savedTheme
                    );
                }
            })();
    </script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HieuLongPortfolio.styles.css"
          asp-append-version="true" />
</head>


<body>

    <!-- ==============================
         NAVIGATION
    =============================== -->

    <header class="portfolio-header">

        <nav class="navbar navbar-expand-lg portfolio-navbar">

            <div class="container">

                <a class="navbar-brand portfolio-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    Long Nguyen

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#portfolioNavbar"
                        aria-controls="portfolioNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="portfolioNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Projects"
                               asp-action="Index">

                                Projects

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Resume"
                               asp-action="Index">

                                Resume

                            </a>

                        </li>


                        <li class="nav-item">

                            <button id="themeToggle"
                                    class="theme-toggle"
                                    type="button"
                                    aria-label="Switch theme">

                                <span id="themeIcon">
                                    ☀
                                </span>

                            </button>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ==============================
         PAGE
    =============================== -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ==============================
         CONTACT / FOOTER
    =============================== -->

    <footer class="portfolio-footer">

        <div class="footer-container">


            <!-- CONTACT BOX -->

            <div class="footer-contact">

                <a href="mailto:longitcanada@gmail.com"
                   class="footer-email">

                    <span class="email-icon">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M2.2 3.1 21 11.2c.8.3.8 1.4 0 1.7L2.2 21c-.8.3-1.5-.5-1.1-1.2l3.2-6.2 8.5-1.6-8.5-1.6-3.2-6.2c-.4-.7.3-1.5 1.1-1.1Z" />

                        </svg>

                    </span>

                    <span>
                        longitcanada@gmail.com
                    </span>

                </a>


                <div class="social-links">


                    <!-- GITHUB -->

                    <a href="https://github.com/01lW"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="GitHub"
                       title="GitHub">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M12 .7C5.7.7.7 5.8.7 12.1c0 5 3.2 9.3 7.6 10.8.6.1.8-.3.8-.6v-2.2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-3 0 0 .9-.3 3.1 1.1a10.7 10.7 0 0 1 5.6 0c2.1-1.4 3.1-1.1 3.1-1.1.6 1.6.2 2.7.1 3 .7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.3-5.1 5.6.4.3.8 1 .8 2v3c0 .4.2.7.8.6a11.4 11.4 0 0 0 7.6-10.8C23.3 5.8 18.3.7 12 .7Z" />

                        </svg>

                    </a>


                    <!-- LINKEDIN -->

                    <a href="https://linkedin.com/in/long-nguyen-518383410"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="LinkedIn"
                       title="LinkedIn">

                        <span class="linkedin-icon">
                            in
                        </span>

                    </a>


                    <!-- INSTAGRAM -->

                    <a href="https://instagram.com/03._01ln"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Instagram"
                       title="Instagram">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm10.5 1.5A1.5 1.5 0 1 1 16 7a1.5 1.5 0 0 1 1.5-1.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />

                        </svg>

                    </a>

                </div>

            </div>


            <!-- COPYRIGHT -->

            <div class="footer-bottom">

                <p>
                    &copy; @DateTime.Now.Year Hieu Long Nguyen
                </p>

                <a asp-controller="Admin"
                   asp-action="Login">

                    Admin Login

                </a>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>